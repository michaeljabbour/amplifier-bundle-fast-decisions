# Fast Decisions -- sample configuration. Copy to .env and edit; nothing here
# is read automatically by a shell -- source it yourself, or export the
# variables you need. No secrets are set below. See docs/MODEL-SETUP.md and
# docs/PRIVACY.md for full details on each backend.

# Which judge family to use when a profile/config omits `backend`:
# local | hosted | jev | deterministic. Profile config always overrides this.
FAST_DECISIONS_JUDGE=local

# When FAST_DECISIONS_JUDGE=local, which local host runs it: ollama (default)
# or mlx (Apple Silicon only, via mlx_lm.server).
FAST_DECISIONS_LOCAL_HOST=ollama

# Model name for the local backend (Ollama or MLX), e.g. qwen3:0.6b.
FAST_DECISIONS_LOCAL_MODEL=qwen3:0.6b

# Base URL for a locally running mlx_lm.server (Apple Silicon only).
FAST_DECISIONS_MLX_URL=http://127.0.0.1:8080

# Base URL for the hosted judge: any OpenAI-compatible endpoint that returns
# top_logprobs (e.g. your own LiteLLM+vLLM deployment). No public default --
# must be https:// unless the host is literal loopback. Alias:
# FAST_DECISIONS_GATEWAY_URL (legacy).
FAST_DECISIONS_HOSTED_URL=https://your-gateway.example/v1

# API token for the hosted judge, read from the environment only -- never a
# config field, never logged. Leave empty here; export it in your shell or
# secret manager instead.
FAST_DECISIONS_HOSTED_TOKEN=

# Model name for the hosted judge; there is no default (a startup error if
# the hosted backend is selected without one).
FAST_DECISIONS_HOSTED_MODEL=

# Gate for any backend that sends state off this machine (hosted, jev). Off
# by default -- state never leaves the machine until this (or the matching
# --allow-external-state / allow_external_state: true config) is set.
FAST_DECISIONS_ALLOW_EXTERNAL_STATE=false

# TypeSafe (Jev) API key, required only for FAST_DECISIONS_JUDGE=jev. Leave
# empty here; export it in your shell or secret manager instead.
TYPESAFE_API_KEY=

# Where decision telemetry (JSONL events) is recorded and read from by the
# observatory viewer and `afast bench`.
AFAST_EVENTS_DIR=~/.amplifier/fast-decisions/events
