From 95c42ad9c882dd8f0e530735e9f101ab8789bb37 Mon Sep 17 00:00:00 2001
From: "Michael J. Jabbour" <michael.jabbour@gmail.com>
Date: Thu, 24 Sep 2026 16:18:27 -0400
Subject: [PATCH] fix(hooks-deprecation): prune the .amplifier scan instead of
 rglob-then-filter

find_source_files() rglob'd every *.yaml under ~/.amplifier and only then
skipped cache/ paths, so each session:start walked the whole module cache
and all stored sessions (5.8 s on a machine with ~35k dirs under
projects/), and matched data stores (a team knowledge base describing
capabilities) as false 'evidence', firing the deprecation injection on
every session. Walk with os.walk, prune cache/projects/logs/data dirs and
hidden dirs during traversal, cap depth at 3, and de-duplicate when cwd is
home. Measured: 5.81 s -> 0.07 s, false positives 15 -> 0.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 .../__init__.py                               | 56 +++++++++++++------
 .../tests/test_deprecation_hook.py            | 38 +++++++++++++
 2 files changed, 77 insertions(+), 17 deletions(-)

diff --git a/modules/hooks-deprecation/amplifier_module_hooks_deprecation/__init__.py b/modules/hooks-deprecation/amplifier_module_hooks_deprecation/__init__.py
index 1f0678c..0fb5553 100644
--- a/modules/hooks-deprecation/amplifier_module_hooks_deprecation/__init__.py
+++ b/modules/hooks-deprecation/amplifier_module_hooks_deprecation/__init__.py
@@ -31,6 +31,7 @@ from __future__ import annotations
 import logging
 from dataclasses import dataclass
 from datetime import date
+import os
 from pathlib import Path
 from typing import Any
 
@@ -130,11 +131,24 @@ def parse_deprecation_configs(raw: dict[str, Any]) -> list[DeprecationConfig]:
     return tombstones
 
 
+# Directories under .amplifier/ that never hold authored configuration:
+# resolved/cached artifacts (#344), session transcripts, and data stores that
+# happen to mention bundle names (e.g. a team knowledge base describing
+# capabilities). Pruned *during* the walk -- filtering after rglob() still
+# enumerates them, which costs seconds per session:start on a well-used
+# machine (~35k dirs / 169 GB under ~/.amplifier/projects in one report).
+_PRUNE_DIRS = frozenset({"cache", "projects", "logs", "team-knowledge", "memory", "memories"})
+# Authored bundle/settings config is shallow: settings*.yaml at the top level,
+# bundles/behaviors a level or two down.
+_MAX_DEPTH = 3
+
+
 def find_source_files(bundle_name: str, search_dirs: list[Path]) -> list[str]:
-    """Scan .amplifier/ directories for files referencing the deprecated bundle.
+    """Scan .amplifier/ directories for authored config referencing the deprecated bundle.
 
     Best-effort: silently skips unreadable files and missing directories.
-    Searches for any YAML file under .amplifier/ that contains the bundle_name string.
+    Searches YAML files under .amplifier/ (at most ``_MAX_DEPTH`` levels deep,
+    skipping hidden directories and ``_PRUNE_DIRS``) that contain the bundle_name string.
 
     Args:
         bundle_name: Name of the deprecated bundle to search for.
@@ -144,27 +158,35 @@ def find_source_files(bundle_name: str, search_dirs: list[Path]) -> list[str]:
         List of absolute file paths containing references to the bundle.
     """
     found: list[str] = []
+    seen: set[str] = set()
 
     for base_dir in search_dirs:
         amp_dir = base_dir / ".amplifier"
         if not amp_dir.is_dir():
             continue
 
-        for yaml_file in amp_dir.rglob("*.yaml"):
-            # Skip resolved/cached artifacts (e.g. .amplifier/cache/...) — the
-            # tombstone's own carrier config is cached on every install and would
-            # otherwise always self-match, defeating require_evidence gating. (#344)
-            # Scope the check to the path *below* .amplifier so a "cache" segment
-            # in an ancestor of base_dir (e.g. a user project under some cache/
-            # dir) doesn't suppress genuine authored config.
-            if "cache" in yaml_file.relative_to(amp_dir).parts:
-                continue
-            try:
-                content = yaml_file.read_text(encoding="utf-8")
-                if bundle_name in content:
-                    found.append(str(yaml_file))
-            except (OSError, UnicodeDecodeError):
-                continue
+        for dirpath, dirnames, filenames in os.walk(amp_dir):
+            depth = len(Path(dirpath).relative_to(amp_dir).parts)
+            if depth >= _MAX_DEPTH:
+                dirnames[:] = []
+            else:
+                dirnames[:] = [
+                    d for d in dirnames if d not in _PRUNE_DIRS and not d.startswith(".")
+                ]
+            for filename in filenames:
+                if not filename.endswith(".yaml"):
+                    continue
+                yaml_file = Path(dirpath) / filename
+                key = str(yaml_file.resolve())
+                if key in seen:
+                    continue
+                seen.add(key)
+                try:
+                    content = yaml_file.read_text(encoding="utf-8")
+                    if bundle_name in content:
+                        found.append(str(yaml_file))
+                except (OSError, UnicodeDecodeError):
+                    continue
 
     return found
 
diff --git a/modules/hooks-deprecation/tests/test_deprecation_hook.py b/modules/hooks-deprecation/tests/test_deprecation_hook.py
index 5881760..488c591 100644
--- a/modules/hooks-deprecation/tests/test_deprecation_hook.py
+++ b/modules/hooks-deprecation/tests/test_deprecation_hook.py
@@ -1301,3 +1301,41 @@ class TestObservabilityRegistration:
             await mount(coordinator, {})
 
         assert coordinator.register_contributor_calls == []
+
+
+class TestFindSourceFilesPruning:
+    """The scan must not walk (or match inside) non-config trees under .amplifier/."""
+
+    def test_skips_runtime_and_data_dirs(self, tmp_path):
+        from amplifier_module_hooks_deprecation import find_source_files
+
+        amp = tmp_path / ".amplifier"
+        (amp / "settings.yaml").parent.mkdir(parents=True)
+        (amp / "settings.yaml").write_text("bundle:\n  app: [hooks-redaction]\n")
+        for noise in ("cache/x", "projects/p/sessions/s", "team-knowledge/kb", "logs", ".hidden"):
+            d = amp / noise
+            d.mkdir(parents=True)
+            (d / "noise.yaml").write_text("mentions hooks-redaction\n")
+        found = find_source_files("hooks-redaction", [tmp_path])
+        assert found == [str(amp / "settings.yaml")]
+
+    def test_depth_limit(self, tmp_path):
+        from amplifier_module_hooks_deprecation import find_source_files
+
+        amp = tmp_path / ".amplifier"
+        shallow = amp / "bundles" / "mine"
+        deep = amp / "a" / "b" / "c" / "d"
+        shallow.mkdir(parents=True)
+        deep.mkdir(parents=True)
+        (shallow / "bundle.yaml").write_text("includes: [hooks-redaction]\n")
+        (deep / "far.yaml").write_text("hooks-redaction\n")
+        found = find_source_files("hooks-redaction", [tmp_path])
+        assert found == [str(shallow / "bundle.yaml")]
+
+    def test_same_dir_searched_twice_reported_once(self, tmp_path):
+        from amplifier_module_hooks_deprecation import find_source_files
+
+        amp = tmp_path / ".amplifier"
+        amp.mkdir()
+        (amp / "settings.yaml").write_text("hooks-redaction\n")
+        assert find_source_files("hooks-redaction", [tmp_path, tmp_path]) == [str(amp / "settings.yaml")]
-- 
